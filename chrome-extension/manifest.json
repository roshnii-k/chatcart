{
  "manifest_version": 3,
  "name": "ChatCart Message Monitor",
  "version": "0.1.1",
  "description": "Monitor WhatsApp Web or ChatCart's simulated inbox and create review drafts.",
  "permissions": ["storage", "notifications", "scripting", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*", "http://127.0.0.1:5173/*", "http://localhost:5173/*", "http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "ChatCart WhatsApp Monitor", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["https://web.whatsapp.com/*", "http://127.0.0.1:5173/*", "http://localhost:5173/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
